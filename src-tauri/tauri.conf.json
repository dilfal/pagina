{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pagina",
  "version": "0.1.0",
  "identifier": "it.df.pagina",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Pagina",
        "width": 1100,
        "height": 750,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "img-src": "'self' asset: http://asset.localhost https: data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'wasm-unsafe-eval'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "img-src": "'self' asset: http://asset.localhost https: data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 http://127.0.0.1:1420 ws://127.0.0.1:1420"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md"
        ],
        "name": "Markdown",
        "description": "Documento Markdown",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": [
          "markdown"
        ],
        "name": "Markdown",
        "description": "Documento Markdown",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "shortDescription": "Editor e lettore Markdown"
  }
}